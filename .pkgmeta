# BigWigs packager: the zip is the addon folder "WandererOutfits", the changelog of the version is CHANGELOG.md
# (written at each release from the full changelog).
package-as: WandererOutfits

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - README.md

# Shown on CurseForge: Wanderer Outfits needs Wanderer.
required-dependencies:
  - wanderer
